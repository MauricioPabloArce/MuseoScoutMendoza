generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  address       String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Novedades y Comunicaciones
  lastLoginAt                 DateTime?
  emailMarketingConsent       Boolean   @default(false)
  emailMarketingConsentAt     DateTime?
  emailMarketingConsentSource String?
  emailMarketingConsentVersion String?
  emailUnsubscribedAt         DateTime?

  accounts Account[]
  sessions Session[]
  member   MuseumMember?
  receivedEmails EmailCampaignRecipient[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MuseumMember {
  id           String   @id @default(cuid())
  userId       String   @unique
  role         String   @default("COLLABORATOR") // ADMIN, COLLABORATOR
  isTeamMember Boolean  @default(false)
  teamPosition String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions   CategoryPermission[]
  ledCategories Category[]           @relation("CategoryLeader")
  specialProjects SpecialProject[]   @relation("CreatorSpecialProjects")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  prefix      String   @unique // Ej. IN para Insignias
  parentId    String?
  order       Int      @default(0)
  imageUrl    String?
  leaderId    String?
  isPublished Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[]    @relation("CategoryHierarchy")
  leader   MuseumMember? @relation("CategoryLeader", fields: [leaderId], references: [id], onDelete: SetNull)

  sections    CategorySection[]
  permissions CategoryPermission[]
  pieces      MuseumPiece[]
}

model CategoryPermission {
  id                 String   @id @default(cuid())
  memberId           String
  categoryId         String
  includeDescendants Boolean  @default(false)
  canView            Boolean  @default(true)
  canCreate          Boolean  @default(false)
  canEdit            Boolean  @default(false)
  canArchive         Boolean  @default(false)
  createdAt          DateTime @default(now())

  member   MuseumMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([memberId, categoryId])
}

model FieldSection {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  order       Int      @default(0)
  createdBy   String? // userId of creator (null = system/admin section)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields     FieldDefinition[]
  categories CategorySection[]
}

model FieldDefinition {
  id           String   @id @default(cuid())
  name         String
  internalKey  String   @unique
  description  String?
  type         String // TEXT, NUMBER, DATE, BOOLEAN, SELECT, MULTISELECT, FILE, IMAGE
  isActive     Boolean  @default(true)
  isRequired   Boolean  @default(false)
  isPublic     Boolean  @default(false)
  isSearchable Boolean  @default(false)
  order        Int      @default(0)
  defaultValue String?
  validation   String? // JSON string
  isGeneral    Boolean  @default(false)
  sectionId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  section     FieldSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  options     FieldOption[]
  pieceValues PieceFieldValue[]
}

model FieldOption {
  id      String @id @default(cuid())
  fieldId String
  label   String
  value   String
  order   Int    @default(0)

  field FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
}

model CategorySection {
  id         String @id @default(cuid())
  categoryId String
  sectionId  String
  order      Int    @default(0)

  category Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  section  FieldSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([categoryId, sectionId])
}

model MuseumPiece {
  id           String   @id @default(cuid())
  registryCode String   @unique
  categoryId   String
  status       String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  registeredAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String? // memberId
  updatedBy    String? // memberId

  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  fieldValues PieceFieldValue[]
  media       PieceMedia[]
}

model PieceFieldValue {
  id      String @id @default(cuid())
  pieceId String
  fieldId String
  value   String // Serialized value

  piece MuseumPiece     @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  field FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([pieceId, fieldId])
}

model PieceMedia {
  id          String   @id @default(cuid())
  pieceId     String
  url         String
  type        String // IMAGE, FILE
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  piece MuseumPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
}

model MuseumSettings {
  id                  String   @id @default(cuid())
  name                String   @default("Museo Scout Mendoza")
  description         String?
  registrySeparator   String   @default("-")
  registrySequenceLen Int      @default(6)
  registryUse4DigitYr Boolean  @default(true)
  registryResetYearly Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model RegistrySequence {
  id        String @id @default(cuid())
  year      Int
  lastValue Int    @default(0)

  @@unique([year])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValue  String? // JSON
  newValue  String? // JSON
  createdAt DateTime @default(now())
}

model Exhibition {
  id        String    @id @default(cuid())
  name      String
  theme     String?
  location  String?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String? // memberId

  images ExhibitionImage[]
}

model ExhibitionImage {
  id           String   @id @default(cuid())
  exhibitionId String
  url          String
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  exhibition Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
}

model SpecialProject {
  id          String   @id @default(cuid())
  name        String
  theme       String?
  description String?
  content     String? // JSON serialized blocks
  objective   String?
  coverImage  String? // URL of presentation image
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String? // memberId

  creator     MuseumMember? @relation("CreatorSpecialProjects", fields: [createdBy], references: [id])
  images      SpecialProjectImage[]
}

model SpecialProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project   SpecialProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model EmailCampaign {
  id              String   @id @default(cuid())
  internalName    String
  subject         String
  preheader       String?
  bodyBlocks      String   // JSON con los bloques del editor
  status          String   @default("BORRADOR") // BORRADOR, PROGRAMADA, ENVIANDO, ENVIADA, CANCELADA, ERROR
  totalRecipients Int      @default(0)
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?  // Id del admin que la creó

  recipients      EmailCampaignRecipient[]
}

model EmailCampaignRecipient {
  id          String   @id @default(cuid())
  campaignId  String
  userId      String?
  email       String
  status      String   @default("PENDING") // PENDING, SENT, DELIVERED, FAILED, BOUNCED, UNSUBSCRIBED
  errorMsg    String?
  sentAt      DateTime?

  campaign    EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([campaignId, email])
}
